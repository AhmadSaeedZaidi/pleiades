# Pleiades MCP server — environment configuration
#
# The MCP tools serve on-demand YouTube media; they do NOT query the Pleiades
# database, but atlas.config still validates DATABASE_URL at import time. Point
# it at any reachable Postgres DSN. All other vars mirror atlas/maia.

# Required by atlas.config validation (not actually queried by the MCP tools).
DATABASE_URL=postgresql://user:pass@localhost:5432/pleiades

# YouTube Data API v3 key pool (JSON array). Used by get_video_metadata and, as
# a fallback, search_youtube if no dedicated MCP pool is set below.
YOUTUBE_API_KEY_POOL_JSON=["your-youtube-api-key-1","your-youtube-api-key-2"]

# OPTIONAL: dedicated reserve pool for search_youtube. When set, search_youtube
# rotates through THESE keys instead of the shared pool above, isolating MCP
# search quota from the agent fleet. Unset -> falls back to the pool above.
MCP_YOUTUBE_API_KEY_POOL_JSON=["your-reserve-key-1","your-reserve-key-2"]

# Mistral API key — powers summarize_transcript (chat) and get_audio transcription (Voxtral).
MISTRAL_API_KEY=your-mistral-api-key

# Vault config (validated by atlas.config; not used by the MCP tools directly).
VAULT_PROVIDER=huggingface
HF_DATASET_ID=username/dataset
HF_TOKEN=your-hf-token

# Optional: where the server caches downloadable artifacts.
# PLEIADES_MCP_ARTIFACT_DIR=/tmp/pleiades_mcp/artifacts
